# Branitz Heat Decision — environment configuration
# Copy to .env and fill in your values.

# Google Gemini API key — used by the NLU intent classifier
# (nlu/intent_classifier.py), the LLM explainer (uhdc/explainer.py),
# and the fallback LLM (agents/fallback.py).
# Without a key the system still works: it falls back to keyword-based
# intent classification and deterministic answer templates.
GOOGLE_API_KEY=your-google-api-key-here

# Gemini model to use (default: gemini-2.5-flash)
GOOGLE_MODEL=gemini-2.5-flash
